[Unit]
Description=LiteLLM过期正文清理，保留全部基础账单
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
Nice=10
WorkingDirectory=/root/litellm/maintenance
ExecStartPre=/usr/bin/find /root/litellm/maintenance/body-retention-canary -maxdepth 1 -type f -name body-*.json.gz -mmin +10080 -delete
ExecStart=/usr/bin/python3 /root/litellm/maintenance/spend_log_body_retention.py --apply --state-file /root/litellm/maintenance/body-retention/state.json --batch-size 100 --run-budget-seconds 1800 --max-batches 2000 --sleep-seconds 1 --min-free-gib 64
TimeoutStartSec=35min
