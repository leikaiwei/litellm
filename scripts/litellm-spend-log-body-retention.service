[Unit]
Description=LiteLLM过期正文清理，保留全部基础账单
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
Nice=10
WorkingDirectory=/root/litellm/maintenance
EnvironmentFile=/root/litellm/maintenance/body-retention-30d/window.env
ExecStart=/usr/bin/python3 /root/litellm/maintenance/spend_log_body_retention.py --apply --state-file /root/litellm/maintenance/body-retention-30d/state.json --retention-days 30 --not-before ${SPENDLOGS_CUTOVER_UTC} --batch-size 50 --run-budget-seconds 25200 --max-batches 6000 --sleep-seconds 1 --min-free-gib 10
TimeoutStartSec=430min
